# DecisionGuru backend configuration. Copy to `.env` and adjust. All vars are DG_-prefixed.

# Server
DG_PORT=5178
DG_HOST=0.0.0.0

# CORS: comma-separated frontend origins, or * for all (dev default).
# e.g. DG_CORS_ORIGINS=http://localhost:5173
DG_CORS_ORIGINS=*

# Database (SQLite file; defaults to backend/data/decisionguru.sqlite)
# DG_DB_PATH=/absolute/path/to/decisionguru.sqlite

# Cache TTLs (seconds)
DG_CACHE_TTL_QUOTE=900
DG_CACHE_TTL_HISTORY=43200
DG_CACHE_TTL_FUND=604800
DG_CACHE_TTL_FX=43200

# Optional Redis-backed TTL cache (falls back to in-process cachetools when empty)
# DG_REDIS_URL=redis://localhost:6379/0

# yfinance reliability
DG_YF_MIN_GAP_MS=700
DG_YF_RETRIES=4
DG_YF_TIMEOUT_S=20
DG_HISTORY_COOLDOWN_MS=60000

# PySpark heavy path (set false to force the pandas reducer everywhere)
DG_SPARK_ENABLED=true
